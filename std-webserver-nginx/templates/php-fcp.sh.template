#!/bin/bash

SITE="SITE_NAME"
PHPMAJ="`cat /home/sites/$SITE/conf/php-fpm/php-major`"
CFGFILE="/home/sites/$SITE/conf/php-fpm/php-fcp.conf"
PHPINI="/home/sites/$SITE/conf/php-fpm/php${PHPMAJ}-fcp.ini"
LOGFILE="/home/sites/$SITE/pub/log/php-fcp.log"
PHPBIN="/opt/php$PHPMAJ/sbin/php-fpm"
PHP_INI_SCAN_DIR="/home/sites/$SITE/conf/php-fpm/php${PHPMAJ}-conf.d"

CFGCHECK="`$PHPBIN --fpm-config $CFGFILE -c $PHPINI -t 2>&1 | grep 'test is successful' `"
if test -z "$CFGCHECK"
then
    echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Error in PHP-FCP configuration" >> $LOGFILE
else
    echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Starting PHP v$PHPMAJ FCP Pool for $SITE ===" >> $LOGFILE
    ${PHPBIN} --daemonize --fpm-config $CFGFILE -c $PHPINI
fi

# eof
