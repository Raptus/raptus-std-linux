#!/bin/bash

SITE="SITE_NAME"
PHPMAJ="`cat /home/sites/$SITE/conf/php-fpm/php-major`"
CFGFILE="/home/sites/$SITE/conf/php-fpm/php-fpm.conf"
PHPINI="/home/sites/$SITE/conf/php-fpm/php${PHPMAJ}.ini"
LOGFILE="/home/sites/$SITE/pub/log/php-fpm.log"
PHPBIN="/home/sites/$SITE/conf/php-fpm/php$PHPMAJ/sbin/php-fpm"
export PHP_INI_SCAN_DIR="/home/sites/$SITE/conf/php-fpm/php${PHPMAJ}-conf.d"

CFGCHECK="`$PHPBIN --fpm-config $CFGFILE -c $PHPINI -t 2>&1 | grep 'test is successful' `"
if test -z "$CFGCHECK"
then
    echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Error in PHP-FPM configuration" >> $LOGFILE
else
    echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Starting PHP v$PHPMAJ FPM Pool for $SITE ===" >> $LOGFILE
    ${PHPBIN} --daemonize --fpm-config $CFGFILE -c $PHPINI
fi

# eof
