/var/log/nginx/*.log /home/sites/*/pub/log/nginx-*.log {
        daily
        missingok
        rotate 52
        compress
        delaycompress
        notifempty
        su root root
        create 640 nginx root
        sharedscripts
        postrotate
                if [ -f /var/run/nginx.pid ]; then
                        kill -USR1 `cat /var/run/nginx.pid`
                fi
        endscript
}
