smtpd_banner = $myhostname ESMTP $mail_name
biff = no

# appending .domain is the MUA's job.
append_dot_mydomain = no

# Uncomment the next line to generate "delayed mail" warnings
#delay_warning_time = 4h

inet_interfaces = loopback-only
inet_protocols = ipv4

# Default is to take the fqdn for the local machine
#myhostname = 
myorigin = $myhostname
mydestination = $myhostname, localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128

#masquerade_classes = envelope_sender, header_sender
masquerade_classes = envelope_sender, envelope_recipient, header_sender, header_recipient
masquerade_domains = $mydomain

mailbox_size_limit = 0
message_size_limit = 50000000
queue_minfree = 100000000
unknown_local_recipient_reject_code = 550
recipient_delimiter = +

database_type = lmdb
alias_maps = lmdb:/etc/aliases
alias_database = lmdb:/etc/aliases

setgid_group = postdrop
html_directory = no

queue_directory = /var/spool/postfix
command_directory = /usr/sbin
daemon_directory = /usr/libexec/postfix
data_directory = /var/lib/postfix
manpage_directory = /usr/share/man
sample_directory = no
readme_directory = no

sendmail_path = /usr/sbin/sendmail.postfix
newaliases_path = /usr/bin/newaliases.postfix
mailq_path = /usr/bin/mailq.postfix

mail_owner = postfix
debug_peer_level = 2
debugger_command =
     PATH=/bin:/usr/bin:/usr/local/bin:/usr/X11R6/bin
     ddd $daemon_directory/$process_name $process_id & sleep 5

smtp_tls_security_level = may
smtp_tls_loglevel = 1

smtpd_relay_restrictions = permit_mynetworks, defer_unauth_destination

# Rate limiting (30 message per minute)
smtpd_client_message_rate_limit = 30
anvil_rate_time_unit = 60s
smtp_destination_rate_delay = 2s

# SMTP over Azure Comm Services
#relayhost = [smtp.azurecomm.net]:587
#smtp_use_tls = yes
#smtp_sasl_password_maps = lmdb:/etc/postfix/smtp_auth
#smtp_sasl_auth_enable = yes
#smtp_sasl_security_options = noanonymous

# SMTP over Sophos FW
#relayhost = [gate.domain.tls]:25
#smtp_sasl_auth_enable = no

# eof
